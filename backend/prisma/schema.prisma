// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== Models ====================

// Users — Candidates, Recruiters, Admins
model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  profileImage String?
  skills     String[] @default([])
  yearsOfExperience Int? @default(0)
  role      Role     @default(CANDIDATE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  resumes         Resume[]
  jobDescriptions JobDescription[]
  candidateSessions Session[] @relation("candidateSessions")
  recruiterSessions Session[] @relation("recruiterSessions")
  // Relations added for Prisma migration
  roomsCreated    Room[]
  roomParticipants RoomParticipant[]
  chats           Chat[]
  activities      Activity[]
  userPreferences UserPreferences?
}

enum Role {
  CANDIDATE
  RECRUITER
  ADMIN
}

// Resumes — PDF uploads + extracted data
model Resume {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  storagePath   String?  // Supabase Storage path (made optional to allow local-only resumes)
  filename      String?
  extractedText String?  @db.Text
  skills        String[] // JSON array
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  chunks        ResumeChunk[]
  sessions      Session[]

  @@index([userId])
}

// Resume Chunks — RAG embedding storage
model ResumeChunk {
  id        String   @id @default(cuid())
  resumeId  String
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  
  content   String   @db.Text
  embedding Unsupported("vector(384)")?  // pgvector vector column (384-dim)
  chunkIndex Int?
  
  createdAt DateTime @default(now())

  @@index([resumeId])
}

// Job Descriptions
model JobDescription {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title         String?
  company       String?
  content       String   @db.Text
  skillsRequired String[] // JSON array
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  sessions      Session[]

  @@index([userId])
}

// Interview Sessions
model Session {
  id            String     @id @default(cuid())
  candidateId   String?
  candidate     User?      @relation("candidateSessions", fields: [candidateId], references: [id])
  
  recruiterId   String?
  recruiter     User?      @relation("recruiterSessions", fields: [recruiterId], references: [id])
  
  resumeId      String?
  resume        Resume?    @relation(fields: [resumeId], references: [id])
  
  jdId          String?
  jd            JobDescription? @relation(fields: [jdId], references: [id])
  
  type          SessionType @default(MOCK)
  status        SessionStatus @default(PENDING)
  
  streamRoomId  String?    // Stream Video room ID (proctored)
  warningCount  Int        @default(0)
  
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Relations
  messages      Message[]
  proctorEvents ProctorEvent[]
  evaluation    Evaluation?

  @@index([candidateId])
  @@index([recruiterId])
  @@index([resumeId])
}

enum SessionType {
  MOCK
  PROCTORED
}

enum SessionStatus {
  PENDING
  ACTIVE
  COMPLETED
  TERMINATED
}

// Conversation Messages
model Message {
  id            String   @id @default(cuid())
  sessionId     String
  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  role          MessageRole @default(AI)
  content       String   @db.Text
  transcriptConf Float?   // Deepgram confidence
  audioDuration Float?   // in seconds
  
  createdAt     DateTime @default(now())

  @@index([sessionId])
}

enum MessageRole {
  AI
  CANDIDATE
}

// Proctoring Events
model ProctorEvent {
  id          String   @id @default(cuid())
  sessionId   String
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  eventType   String   // 'no_face', 'multiple_faces', 'gaze_off', 'tab_switch', etc.
  severity    EventSeverity
  warningNum  Int?     // 1, 2, or 3
  metadata    Json?    @db.JsonB
  
  createdAt   DateTime @default(now())

  @@index([sessionId])
}

enum EventSeverity {
  WARNING
  SEVERE
}

// Evaluations
model Evaluation {
  id                 String   @id @default(cuid())
  sessionId          String   @unique
  session            Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  technicalScore    Int?     // 0-100
  communicationScore Int?     // 0-100
  confidenceScore   Int?     // 0-100
  behavioralScore   Int?     // 0-100
  
  strengths         String[] // JSON array
  weaknesses        String[] // JSON array
  improvements      String[] // JSON array
  detailedFeedback  String?  @db.Text
  reportPath        String?  // Supabase Storage path
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([sessionId])
}

// Job Queue for async evaluations
model Job {
  id        String   @id @default(cuid())
  type      String   // 'evaluate', 'generate_report', etc.
  status    JobStatus @default(PENDING)
  payload   Json     @db.JsonB
  result    Json?    @db.JsonB
  error     String?
  
  attempts  Int      @default(0)
  maxRetries Int     @default(3)
  
  processedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([type])
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// Room model and related types (from mongoose Room schema)
model Room {
  id        String   @id @default(cuid())
  name      String
  description String?
  creatorId String
  creator   User     @relation(fields: [creatorId], references: [id])
  roomType  RoomType @default(GENERAL)
  isPublic  Boolean  @default(false)
  password  String?  
  config    Json?    // store roomConfig as JSON
  sharedCode Json?   // store language, code, lastEditedBy, lastEditedAt
  status    RoomStatus @default(ACTIVE)
  tags      String[] @default([])
  recordingUrl String?
  recordingActive Boolean @default(false)
  recordingStartedAt DateTime?
  expiresAt DateTime?

  participants RoomParticipant[]
  chats        Chat[]
  activities   Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
  @@index([roomType])
  @@index([isPublic])
}

model RoomParticipant {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ParticipantRole @default(VIEWER)
  joinedAt  DateTime @default(now())
  permissions Json?  // canEdit, canExecute, etc.
  isMuted   Boolean  @default(false)
  isCameraOff Boolean @default(false)
  isScreenSharing Boolean @default(false)
}

enum RoomType {
  INTERVIEW
  PAIR_PROGRAMMING
  TEAM_MEETING
  STUDY_GROUP
  GENERAL
}

enum ParticipantRole {
  CREATOR
  PRESENTER
  VIEWER
  INTERVIEWER
  CANDIDATE
  OBSERVER
}

enum RoomStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

// Chat model
model Chat {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderName String
  senderAvatar String?
  message   String
  messageType MessageType @default(TEXT)
  codeLanguage String?
  isEdited  Boolean @default(false)
  editedAt  DateTime?
  reactions Json?  // array of { emoji, userId, userName }
  mentionedUsers String[] @default([])

  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
}

enum MessageType {
  TEXT
  CODE
  SYSTEM
}

// Activity model
model Activity {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName  String
  eventType ActivityEventType
  description String?
  metadata  Json?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
  @@index([userId, createdAt])
}

enum ActivityEventType {
  JOINED
  LEFT
  CODE_EXECUTED
  CODE_SHARED
  SCREEN_SHARED
  CAMERA_TOGGLED
  MIC_TOGGLED
  MESSAGE_SENT
  ROLE_CHANGED
  PERMISSIONS_CHANGED
}

// UserPreferences model
model UserPreferences {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomPreferences Json?  // defaultLayout, autoStartCamera, etc.
  codePreferences Json?  // defaultLanguage, fontSize, theme
  notificationPreferences Json?
  privacySettings Json?
  favoritedRooms String[] @default([]) // array of room ids
  blockedUsers String[] @default([])   // array of user ids

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
